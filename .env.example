# Copia este archivo como .env y cambia los valores

# Credenciales de PostgreSQL que usa docker-compose
POSTGRES_USER=ghibli
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=ghibli_users

# Conexión para correr la API fuera de Docker (uv run uvicorn ...)
DATABASE_URL=postgresql://ghibli:cambia-esta-contraseña@localhost:5432/ghibli_users

# Imprime en consola las consultas SQL (solo para desarrollo)
SQL_ECHO=true

# Clave para firmar los tokens JWT (genera una con: openssl rand -hex 32)
JWT_SECRET_KEY=cambia-esta-clave
# Minutos que dura un token
JWT_EXPIRE_MINUTES=30
